# REQUIRED: Mapbox token for 3D map rendering & geocoding
VITE_MAPBOX_TOKEN=pk.eyJ1...

# OPTIONAL: JamBase Data API v3 key for fast concert loading
VITE_JAMBASE_TOKEN=jbd_live_your_key_here

# Authentication backend (disabled by default; server-only values)
# Changing AUTH_SECRET invalidates every outstanding login and session.
AUTH_MODE=disabled
# Required when AUTH_MODE is optional or required. Set :memory: only for tests.
AUTH_DATABASE_PATH=/path/to/neighborhood-guru.sqlite
AUTH_SECRET=replace-with-at-least-32-random-characters